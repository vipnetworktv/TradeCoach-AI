# Copy to .env.local for local development.
# Set the same values in Vercel Project Settings for production.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
# Server-only. Use the service role / secret key from Supabase.
SUPABASE_SECRET_KEY=your_service_role_key

# --- App URLs (required for PayPal return URLs + report links) ---
NEXT_PUBLIC_APP_URL=https://tradecoachai.org
FRONTEND_URL=https://tradecoachai.org
# FastAPI trade sync server (extension sends fills here)
NEXT_PUBLIC_API_URL=https://api.tradecoachai.org

# --- OpenAI (required for AI Coach chat + voice) ---
OPENAI_API_KEY=sk-...
# Optional overrides
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=verse
# OPENAI_TTS_PREVIEW_MODEL=gpt-4o-mini-tts

# --- PayPal billing (required for subscriptions) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Create with: npm run paypal:plan
PAYPAL_PLAN_ID=your_billing_plan_id
# Register webhook at https://your-domain.com/api/paypal/webhook
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- Email reports (required for notification cron + test emails) ---
RESEND_API_KEY=re_...
EMAIL_FROM=TradeCoach AI <reports@yourdomain.com>

# --- Vercel cron auth (required in production for /api/cron/notifications) ---
# Vercel sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_secret

# --- Production custom domain checklist (tradecoachai.org) ---
# 1. Vercel -> Settings -> Environment Variables (Production):
#    NEXT_PUBLIC_APP_URL=https://tradecoachai.org
#    FRONTEND_URL=https://tradecoachai.org
#    NEXT_PUBLIC_API_URL=https://api.tradecoachai.org
#    Then Redeploy.
# 2. Supabase Auth -> URL Configuration:
#    Site URL = https://tradecoachai.org
#    Redirect URLs:
#      https://tradecoachai.org/**
#      https://www.tradecoachai.org/**
#      https://tradecoachai.org/auth/callback
# 3. PayPal Developer -> Webhook URL:
#    https://tradecoachai.org/api/paypal/webhook
# 4. Resend: verify EMAIL_FROM domain (SPF/DKIM).
# 5. Backend .env: FRONTEND_URL=https://tradecoachai.org
#    Deploy backend at api.tradecoachai.org (CNAME to your host).
# 6. Chrome extension: extension/config.js uses production URLs.
# 7. Run: npm run verify:env:production
