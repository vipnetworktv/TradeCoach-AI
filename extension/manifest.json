{
  "manifest_version": 3,
  "name": "TradeCoach Sync",
  "version": "0.5.3",
  "description": "Automatically sync Tradovate and NinjaTrader Web trades with TradeCoach AI.",
  "permissions": ["tabs", "alarms", "scripting", "storage"],
  "host_permissions": [
    "https://trader.tradovate.com/*",
    "https://*.tradovate.com/*",
    "https://web-trader.ninjatrader.com/*",
    "https://tradecoachai.org/*",
    "https://www.tradecoachai.org/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TradeCoach Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradovate.com/*",
        "https://trader.tradovate.com/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web-trader.ninjatrader.com/*"],
      "js": ["page-bridge-ninjatrader.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://trader.tradovate.com/*",
        "https://web-trader.ninjatrader.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
