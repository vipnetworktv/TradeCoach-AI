{
  "manifest_version": 3,
  "name": "TradeCoach Sync",
  "version": "0.9.0",
  "description": "Automatically sync TradingView trades with TradeCoach AI.",
  "permissions": ["tabs", "alarms", "scripting", "storage"],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://*.tradingview.com/*",
    "https://tradecoachai.org/*",
    "https://www.tradecoachai.org/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TradeCoach Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["page-bridge-tradingview.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://*.tradingview.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
